{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "compress": {
    "mode": "range",
    "permission": "allow",
    "maxContextLimit": 150000,
    "minContextLimit": 100000,
    "nudgeFrequency": 5
  },
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4
    }
  }
}
