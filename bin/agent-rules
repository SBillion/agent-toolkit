#!/usr/bin/env bash
# Install the agent rules (and optionally the commit-msg hook) in this repo.
set -euo pipefail

usage() {
  cat >&2 <<'U'
usage: agent-rules [PREFIX] [base-branch] [--tracker linear|outline|none] [--hooks] [--force]

  PREFIX          ticket prefix (INT, LET, EXS…). Omit it with --tracker none.
  --tracker       what tracks the work: linear (default), outline, or none.
  --hooks         install .githooks/commit-msg (needs a PREFIX)
  --force         overwrite an existing commit-msg hook

  agent-rules INT main --hooks
  agent-rules --tracker none --hooks     # personal repo, no tickets
U
  exit 2
}

prefix=""
base="main"
tracker="linear"
hooks=0
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --hooks) hooks=1 ;;
    --force) force=1 ;;
    --tracker)
      [ $# -ge 2 ] || usage
      tracker="$2"; shift ;;
    --tracker=*) tracker="${1#*=}" ;;
    -*) usage ;;
    *) if [ -z "$prefix" ]; then prefix="$1"; else base="$1"; fi ;;
  esac
  shift
done

case "$tracker" in
  linear|outline|none) ;;
  *) echo "--tracker must be linear, outline or none" >&2; exit 2 ;;
esac
if [ -z "$prefix" ] && [ "$tracker" != none ]; then
  echo "a PREFIX is required with --tracker $tracker" >&2; exit 2
fi
if [ "$hooks" = 1 ] && [ -z "$prefix" ]; then
  echo "the commit-msg hook needs a PREFIX (it writes the ticket from the branch)" >&2; exit 2
fi

self="$(readlink "$0" || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not inside a git repository" >&2; exit 1; }

dest="$root/docs/rules"
if [ -e "$dest" ]; then
  echo "kept existing $dest (delete it to reinstall)" >&2
else
  mkdir -p "$dest"
  for f in "$here"/templates/rules/*.md; do
    sed -e "s/<PREFIX>/$prefix/g" -e "s/<BASE_BRANCH>/$base/g" -e "s/<TRACKER>/$tracker/g" \
      "$f" >"$dest/$(basename "$f")"
  done
  echo "wrote $dest"
fi

if [ "$hooks" = 1 ]; then
  hook="$root/.githooks/commit-msg"
  if [ -e "$hook" ] && [ "$force" != 1 ]; then
    echo "kept existing $hook — diff it against $here/templates/hooks/commit-msg, or add --force" >&2
  else
    mkdir -p "$root/.githooks"
    sed "s/<PREFIX>/$prefix/g" "$here/templates/hooks/commit-msg" >"$hook"
    chmod +x "$hook"
    echo "installed $hook"
  fi
  if [ -f "$root/.pre-commit-config.yaml" ]; then
    # core.hooksPath replaces .git/hooks, which is where pre-commit installs —
    # setting it here would silently stop every other hook in the repo.
    cat >&2 <<'PRE'
left core.hooksPath untouched: this repo runs pre-commit, which owns .git/hooks.
Declare the hook in .pre-commit-config.yaml and install it through pre-commit:

    - id: commit-msg
      name: commit-msg (the ticket closes the subject)
      entry: bash .githooks/commit-msg
      language: system
      stages: [commit-msg]

    pre-commit install --hook-type pre-commit --hook-type commit-msg
PRE
  else
    current="$(git -C "$root" config --get core.hooksPath || true)"
    if [ -z "$current" ]; then
      git -C "$root" config core.hooksPath .githooks
      echo "core.hooksPath=.githooks"
    elif [ "$current" != ".githooks" ]; then
      echo "left core.hooksPath=$current untouched" >&2
    fi
  fi
fi

cat <<EOF

Point AGENTS.md at the rules, before your first branch or commit:

## Agent rules

Delivery, GSD, testing, language and security rules: [\`docs/rules/index.md\`](docs/rules/index.md).
Read it before your first branch or commit.

Or load them always, in opencode.json: "instructions": ["AGENTS.md", "docs/rules/index.md"].
EOF
